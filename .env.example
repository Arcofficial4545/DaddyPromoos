# Copy to .env.local and fill in. Never commit real values.

# Supabase Postgres. Use the TRANSACTION pooler URI (port 6543) — the app's
# connection settings in lib/db/client-node.ts assume it.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Any long random string. Signs the admin session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# http://localhost:3000 locally; the canonical https:// origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email via Resend. Optional — without a key the form still saves
# submissions to the DB, it just doesn't send a notification.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Read only by scripts/seed.ts when creating the first admin user.
ADMIN_EMAIL=
ADMIN_PASSWORD=
